+static PyObject *first_k_unique_by_head(PyObject *self, PyObject *args) {
+    PyArrayObject *py_candidates;
+    int num_kv_heads, ratio, output_size;
+
+    if (!PyArg_ParseTuple(args, "O!iii", &PyArray_Type, &py_candidates,
+                          &num_kv_heads, &ratio, &output_size))
+        return NULL;
+
+    if (PyArray_NDIM(py_candidates) != 3 ||
+        PyArray_TYPE(py_candidates) != NPY_INT32 ||
+        !PyArray_IS_C_CONTIGUOUS(py_candidates)) {
+        PyErr_SetString(PyExc_ValueError,
+                        "candidates must be a contiguous int32 [Q,2,N] array");
+        return NULL;
+    }
+
+    npy_intp *shape = PyArray_SHAPE(py_candidates);
+    if (shape[0] != num_kv_heads * ratio || shape[1] != 2) {
+        PyErr_SetString(PyExc_ValueError, "candidate shape does not match GQA");
+        return NULL;
+    }
+
+    int num_candidates = (int)shape[2];
+    int32_t *input = (int32_t *)PyArray_DATA(py_candidates);
+    npy_intp dims[2] = {num_kv_heads, output_size};
+    PyArrayObject *py_output =
+        (PyArrayObject *)PyArray_EMPTY(2, dims, NPY_INT32, 0);
+    int32_t *output = (int32_t *)PyArray_DATA(py_output);
+
+#pragma omp parallel for
+    for (int h = 0; h < num_kv_heads; ++h) {
+        int count = 0;
+        for (int c = 0; c < num_candidates && count < output_size; ++c) {
+            for (int r = 0; r < ratio && count < output_size; ++r) {
+                int qh = h * ratio + r;
+                int32_t value = input[(qh * 2) * num_candidates + c];
+                bool seen = false;
+                for (int j = 0; j < count; ++j) {
+                    if (output[h * output_size + j] == value) {
+                        seen = true;
+                        break;
+                    }
+                }
+                if (!seen)
+                    output[h * output_size + count++] = value;
+            }
+        }
+        for (; count < output_size; ++count)
+            output[h * output_size + count] = -1;
+    }
+
+    return (PyObject *)py_output;
+}
